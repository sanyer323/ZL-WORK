page {
  background: #f7f3ee;
  color: #2c1810;
  font-family: 'PingFang SC', 'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fffdf9;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(44, 24, 16, 0.06);
  border: 1rpx solid rgba(139, 69, 19, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5c3d2e;
  margin-bottom: 16rpx;
}

.money {
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-weight: 700;
  color: #8b4513;
}

.money-lg {
  font-size: 64rpx;
}

.money-sm {
  font-size: 36rpx;
}

.text-muted {
  color: #8a7a6a;
  font-size: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 24rpx 48rpx;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-outline {
  background: transparent;
  color: #8b4513;
  border: 2rpx solid #8b4513;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: rgba(139, 69, 19, 0.1);
  color: #8b4513;
}

.tag-success {
  background: rgba(46, 125, 50, 0.12);
  color: #2e7d32;
}

.tag-warn {
  background: rgba(237, 108, 2, 0.12);
  color: #ed6c02;
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #8a7a6a;
}
