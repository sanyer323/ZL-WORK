.month-picker {
  text-align: center;
  padding: 16rpx;
  color: #8b4513;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.stat-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.08);
}

.stat-line:last-child {
  border-bottom: none;
}

.rank-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.06);
  font-size: 26rpx;
}

.plus {
  color: #2e7d32;
}
