.search-bar {
  margin-bottom: 24rpx;
}

.search-bar input {
  background: #fffdf9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(139, 69, 19, 0.1);
}

.student-item {
  margin-bottom: 16rpx;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.row-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 26rpx;
}
