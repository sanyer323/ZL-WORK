<wxs module="fmt" src="../../utils/format.wxs" />

<view class="container">
  <view class="preview-banner" wx:if="{{previewMode}}">
    本地预览模式 · 数据保存在本机，配置云开发后切换正式版
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{loadError && !student}}">
    <view class="card hero">
      <view class="hero-title">暂时无法连接服务</view>
      <view class="text-muted">{{loadError}}</view>
      <view class="text-muted" style="margin-top:16rpx">可先使用预览数据，或到「我的」绑定学员后重试。</view>
      <button class="btn-primary retry-btn" bindtap="loadData">重新加载</button>
    </view>
  </block>

  <block wx:elif="{{!student}}">
    <view class="card hero">
      <view class="hero-title">欢迎来到文房书法</view>
      <view class="text-muted">首次使用请到「我的」绑定学员信息，绑定后即可自助充值、上课签到扣费。</view>
      <button class="btn-primary retry-btn" bindtap="goBind">去绑定</button>
    </view>
  </block>

  <block wx:else>
    <view class="card balance-card">
      <view class="text-muted">账户余额（元）</view>
      <view class="money money-lg">¥{{fmt.money(student.balance)}}</view>
      <view class="text-muted sub">
        单次课费 ¥{{fmt.money(classPrice)}} · 约 {{student.estimatedLessons || 0}} 次课
      </view>
      <view class="actions">
        <button class="btn-primary" bindtap="goRecharge">充值</button>
        <button class="btn-outline" bindtap="goCheckin">{{checkedInToday ? '今日已签到' : '去签到'}}</button>
      </view>
    </view>

    <view class="card" wx:if="{{checkedInToday}}">
      <view class="tag tag-success">今日已签到扣费</view>
      <view class="text-muted" style="margin-top:12rpx">无需重复签到，祝练字愉快。</view>
    </view>

    <view class="card" wx:if="{{student.balance < classPrice}}">
      <view class="tag tag-warn">余额不足</view>
      <view class="text-muted" style="margin-top:12rpx">余额低于单次课费，请先充值后再签到。</view>
    </view>

    <view class="card">
      <view class="card-title">最近明细</view>
      <block wx:if="{{recentRecords.length}}">
        <view class="record-row" wx:for="{{recentRecords}}" wx:key="_id">
          <view>
            <view>{{item.title}}</view>
            <view class="text-muted">{{fmt.dateTime(item.createdAt)}}</view>
          </view>
          <view class="money {{item.amount > 0 ? 'plus' : 'minus'}}">
            {{item.amount > 0 ? '+' : ''}}{{fmt.money(item.amount)}}
          </view>
        </view>
      </block>
      <view wx:else class="text-muted">暂无记录</view>
      <view class="link" bindtap="goRecords">查看全部 →</view>
    </view>
  </block>

  <view class="admin-entry" wx:if="{{isAdmin && !loading}}" bindtap="goAdmin">
    老板后台 →
  </view>
</view>
