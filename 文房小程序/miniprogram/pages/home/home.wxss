.preview-banner {
  background: #fff3e0;
  color: #e65100;
  font-size: 22rpx;
  text-align: center;
  padding: 12rpx 24rpx;
  margin: -32rpx -32rpx 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #5c3d2e;
}

.retry-btn {
  margin-top: 32rpx;
  width: 100%;
}

.balance-card .sub {
  margin: 8rpx 0 32rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.actions button {
  flex: 1;
  margin: 0;
}

.record-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.08);
}

.record-row:last-child {
  border-bottom: none;
}

.plus {
  color: #2e7d32;
}

.minus {
  color: #8b4513;
}

.link {
  text-align: center;
  color: #8b4513;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.admin-entry {
  text-align: center;
  color: #8a7a6a;
  font-size: 26rpx;
  padding: 32rpx;
}
