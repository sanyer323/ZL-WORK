.checkin-page {
  text-align: center;
}

.date-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(139, 69, 19, 0.1);
  border-radius: 32rpx;
  color: #8b4513;
  margin-bottom: 48rpx;
}

.checkin-circle {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  margin: 0 auto 48rpx;
  background: linear-gradient(145deg, #8b4513, #a0522d);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(139, 69, 19, 0.35);
}

.checkin-circle.done {
  background: linear-gradient(145deg, #2e7d32, #43a047);
  box-shadow: 0 16rpx 48rpx rgba(46, 125, 50, 0.3);
}

.circle-inner {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.circle-sub {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  margin-top: 8rpx;
  opacity: 0.9;
}

.stats {
  display: flex;
  text-align: left;
}

.stat-item {
  flex: 1;
}

.stat-item + .stat-item {
  border-left: 1rpx solid rgba(139, 69, 19, 0.1);
  padding-left: 32rpx;
}

.tip {
  margin: 24rpx 16rpx 48rpx;
  line-height: 1.6;
}

.check-btn {
  width: 100%;
}

.empty-card {
  text-align: left;
}
