<wxs module="fmt" src="../../utils/format.wxs" />

<view class="container checkin-page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{!student}}">
    <view class="card empty-card">
      <view>尚未绑定学员信息</view>
      <view class="text-muted">预览模式下应自动显示学员；正式环境请到「我的」绑定。</view>
      <button class="btn-primary" style="margin-top:24rpx" bindtap="goProfile">去我的</button>
    </view>
  </block>

  <block wx:else>
    <view class="date-badge">{{today}}</view>

    <view class="checkin-circle {{checkedInToday ? 'done' : ''}}" bindtap="onCheckin">
      <view class="circle-inner">
        <text wx:if="{{checkedInToday}}">已签到</text>
        <text wx:else>点击签到</text>
        <text class="circle-sub">扣 ¥{{fmt.money(classPrice)}}</text>
      </view>
    </view>

    <view class="card stats">
      <view class="stat-item">
        <view class="text-muted">当前余额</view>
        <view class="money money-sm">¥{{fmt.money(student.balance)}}</view>
      </view>
      <view class="stat-item">
        <view class="text-muted">累计上课</view>
        <view class="money money-sm">{{student.totalClasses || 0}} 次</view>
      </view>
    </view>

    <view class="text-muted tip">每次到课点击一次，系统自动扣费并记录，老板无需手工统计。</view>
  </block>

  <button
    wx:if="{{student && !checkedInToday}}"
    class="btn-primary check-btn"
    loading="{{checking}}"
    disabled="{{checking}}"
    bindtap="onCheckin"
  >
    确认今日到课并扣费
  </button>
</view>
