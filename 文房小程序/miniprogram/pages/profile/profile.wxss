.profile-card .name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.balance-line {
  margin: 24rpx 0 8rpx;
  font-size: 30rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.form-row text {
  width: 80rpx;
  color: #5c3d2e;
}

.form-row input {
  flex: 1;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.2);
  padding: 12rpx 0;
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.08);
  color: #2c1810;
}

.menu-item:last-child {
  border-bottom: none;
}

.footer {
  text-align: center;
  padding: 48rpx;
}
