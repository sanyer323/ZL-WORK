.summary-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(139, 69, 19, 0.08);
}

.record-item:last-child {
  border-bottom: none;
}

.record-title {
  font-weight: 500;
  margin-bottom: 4rpx;
}

.plus {
  color: #2e7d32;
}

.minus {
  color: #8b4513;
}
